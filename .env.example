# ============================================================
# CRM para Agencias — Variables de entorno
# Copiá este archivo a .env y completá. Sin esto, el sistema
# guarda en local (.data/) igual, para que puedas desarrollar.
# ============================================================

# --- Supabase (persistencia real) ---
# Supabase > Project Settings > API
#   SUPABASE_URL                = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY   = "service_role" (SECRETO, solo server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude / Anthropic (Fase siguiente: análisis con IA) ---
ANTHROPIC_API_KEY=

# --- Acceso al panel /admin ---
# Gate de UI (no es seguridad real: las VITE_* quedan en el bundle).
# La protección real va con Supabase Auth + RLS.
VITE_ADMIN_USER=
VITE_ADMIN_PASSWORD=
