# ============================================================
# CRM para Agencias — Variables de entorno
# Copiá este archivo a .env y completá. Sin esto, el sistema
# guarda en local (.data/) igual, para que puedas desarrollar.
# ============================================================

# --- Supabase (persistencia real) ---
# Supabase > Project Settings > API
#   SUPABASE_URL                = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY   = "service_role" (SECRETO, solo server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (IA del Generador de Workspace — GRATIS, free tier) ---
# Sacá tu key en https://console.groq.com/keys (registro gratis).
# Sin esta key, el Generador de Workspace funciona igual con el motor
# determinístico local; con la key, Groq refina el resultado.
GROQ_API_KEY=

# --- Claude / Anthropic (opcional, alternativa de pago) ---
ANTHROPIC_API_KEY=

# --- Acceso al panel /admin ---
# Gate de UI (no es seguridad real: las VITE_* quedan en el bundle).
# La protección real va con Supabase Auth + RLS.
VITE_ADMIN_USER=
VITE_ADMIN_PASSWORD=
